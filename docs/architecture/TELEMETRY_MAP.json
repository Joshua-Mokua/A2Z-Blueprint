  "signal_categories": {
    "1_api_audit_events": {
      "canonical_emitter": {"module": "utils/api.py", "function": "_audit", "line": 170, "signature": "_audit(action: str, user: dict, detail: str = \"\") -> None"},
      "sinks": ["data/audit_log.json (append-only JSON array)", "data/audit_trail.jsonl (line-delimited JSON)"],
      "git": "gitignored",
      "naming_convention": "API_<DOMAIN>_<ACTION>[_<MODIFIER>]",
      "domain_values": ["LOGIN", "LOGOUT", "BSC", "PIPELINE", "CREDIT", "AML", "USERS", "DASHBOARD", "CACHE", "INTEGRATION", "ROLE_WEIGHTS", "KPI_DEDUP", "BACKUP_RETENTION", "TEST_CLEANUP", "BSC_PILLAR", "BSC_LIBRARY", "BSC_COMPLETENESS", "BSC_WEIGHTS", "BSC_CODES", "ADMIN_VALIDATION", "CASCADE_360", "HARMONIZE", "ONBOARDING", "EXIT_RISK", "HR_AUDIT", "PEER_LEARNING", "COACHING", "PREDICT", "GAMIFICATION", "EFFICIENCY", "WELLNESS", "HR_ACTUALS", "VITALS"],
      "events_documented_count": 36,
      "enforcement_gate": "gate_audit_coverage (scripts/audit.py:251)",
      "enforcement_severity": "CRITICAL"
    },

    "2_cross_organ_events": {
      "canonical_interfaces": ["utils/event_bus.py", "utils/cross_organ_event_bus.py"],
      "api_surface_verification_status": "OI-19 pending Stage C",
      "expected_publisher_api": "publish(event_type, payload, source_module)",
      "expected_subscriber_api": "@subscribe(event_type) decorator",
      "namespaces": ["auth.*", "bsc.*", "cascade.*", "pipeline.*", "credit.*", "risk.*", "compliance.*", "hr.*", "treasury.*", "cbs.*", "api.*", "vitals.*", "mlops.*", "system.*"],
      "publication_rules": [
        "Only Managers and engines may publish",
        "Transports MUST NOT publish directly",
        "Events MUST include event_type, timestamp, actor, payload, source_module",
        "Subscribers MUST be idempotent"
      ],
      "replay_engine": "utils/workflow_replay.py"
    },

    "3_observability_metrics": {
      "canonical_interfaces": ["utils/observability_monitoring.py", "utils/api_telemetry.py", "utils/it_observability.py"],
      "sinks": ["data/observability_metrics.json (rolling)", "external platform via OTLP (future)"],
      "categories": [
        "API performance (api.endpoint.duration_ms, api.endpoint.error_rate, api.cors.rejected)",
        "Engine performance (engine.bsc.score_compute.duration_ms, engine.cascade.walk.duration_ms)",
        "Data freshness (data.kpi_library.last_updated, data.cbs_baseline.staleness_hours)",
        "Audit health (audit.gate.pass_rate, audit.gate.failures.count)",
        "Org health (vitals.organ.<name>.status, vitals.regression.count)",
        "ML drift (mlops.model.<id>.accuracy_drift, mlops.adjudication.queue_depth)"
      ],
      "performance_gate": "gate_performance_api_latency (scripts/audit.py:2897)",
      "thresholds_oi": "OI-32 — exact thresholds in Stage C amendment"
    },

    "4_anomaly_detections": {
      "canonical_interfaces": ["utils/anomaly_observer.py", "utils/analytics_anomaly_detection.py", "utils/behavioral_anomaly_detection.py", "utils/revenue_anomaly_patterns.py"],
      "sinks": "event_bus namespace anomaly.*",
      "alert_routing_via": "utils/command_centre_alert_routing.py",
      "anomaly_types": [
        {"type": "Transaction anomaly", "detector": "anomaly_observer", "trigger": "Unusual transaction pattern for customer"},
        {"type": "AML anomaly", "detector": "aml_monitoring + behavioral", "trigger": "Velocity, structuring, smurfing"},
        {"type": "Revenue anomaly", "detector": "revenue_anomaly_patterns", "trigger": "Sudden revenue drop in branch/SBU"},
        {"type": "Performance anomaly", "detector": "behavioral_anomaly_detection", "trigger": "Staff productivity outside expected range"},
        {"type": "Risk threshold", "detector": "Risk engines", "trigger": "VaR breach, limit utilization >100%"}
      ]
    },

    "5_alerts_notifications": {
      "canonical_interfaces": ["utils/notification_broadcaster.py", "utils/notifications.py", "utils/smart_alerts.py", "utils/smart_alerts_i18n.py", "utils/nudge_engine.py", "utils/command_centre_alert_routing.py", "utils/command_centre_crisis.py", "utils/command_centre_stakeholder_comms.py"],
      "channels": [
        {"channel": "Email", "implementation": "utils/core.py:71-280", "use_case": "Async escalations, welcome emails"},
        {"channel": "In-app", "implementation": "Streamlit toasts, React sonner", "use_case": "Real-time UX feedback"},
        {"channel": "WebSocket", "implementation": "utils/websocket_manager.py", "use_case": "Push to active sessions"},
        {"channel": "Mobile", "implementation": "utils/mobile_app_tracking.py, utils/command_centre_mobile_board.py", "use_case": "Mobile devices"}
      ],
      "wellness_alert_ethical_constraints": [
        "Go only to staff's direct manager",
        "Never include speculative diagnoses",
        "Direct manager receives suggestions, not directives",
        "Subject staff has visibility into their own assessment"
      ]
    }
  },

