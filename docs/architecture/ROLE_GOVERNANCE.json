  "oi_1_require_role_name_collision_resolution": {
    "problem": "Two functions named require_role with incompatible signatures",
    "location_a": {
      "module": "utils/auth.py",
      "alias_target": "require_access",
      "signature": "require_role(module: str, user: Optional[Dict]) -> bool",
      "semantics": "Streamlit page gate"
    },
    "location_b": {
      "module": "utils/auth_jwt.py",
      "signature": "require_role(roles: list[str]) -> Callable",
      "semantics": "FastAPI Depends factory",
      "returns": "Inner _checker that validates JWT role claim"
    },
    "resolution": "Rename utils/auth.py::require_role → require_module_access",
    "rationale": [
      "Streamlit function semantics ('require access to module') captured by require_module_access",
      "Name require_role accurately describes the FastAPI factory",
      "Streamlit version is transitional; FastAPI version is canonical going forward"
    ],
    "migration_steps": [
      "Rename internal alias in utils/auth.py: require_role = require_access → require_module_access = require_access",
      "Update __all__: remove require_role, add require_module_access",
      "Add DeprecationWarning shim for one batch grace period",
      "Update every pages/*.py import: from utils.auth import require_role → require_module_access",
      "Update call sites: require_role(\"name\") → require_module_access(\"name\")",
      "Add gate_no_require_role_collision in Stage C",
      "Remove deprecation shim one batch later"
    ],
    "severity_classification": {
      "before_rename": "HIGH (transitional collision; flagged at warning during grace)",
      "after_rename_if_reintroduced": "CRITICAL (constitutional rot)"
    },
    "timeline": {
      "wave_2_this_batch": "Declared resolution path; gate placeholder in Stage C",
      "next_governance_batch": "Execute rename + import updates + gate activation",
      "one_batch_after": "Remove deprecation shim"
    }
  },

