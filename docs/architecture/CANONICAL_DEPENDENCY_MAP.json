  "event_bus_contract": {
    "canonical_interfaces": ["utils/event_bus.py", "utils/cross_organ_event_bus.py"],
    "api_surface_oi": "OI-19 — bodies not yet surveyed",
    "publication_rules": [
      "Only Managers and engines may publish events",
      "Transports MUST NOT publish events directly (they call Managers, which publish)",
      "Events MUST include event_type, timestamp, actor (if known), payload, source_module",
      "Subscribers MUST be idempotent (events may be replayed)"
    ],
    "event_categories_observed": [
      {"category": "BSC updates", "examples": ["bsc.score.computed", "bsc.target.cascaded", "bsc.actual.updated"]},
      {"category": "Pipeline events", "examples": ["pipeline.deal.created", "pipeline.deal.moved", "pipeline.deal.won/lost"]},
      {"category": "HR lifecycle", "examples": ["hr.staff.registered", "hr.staff.transferred", "hr.staff.terminated"]},
      {"category": "Risk alerts", "examples": ["risk.threshold.breached", "risk.limit.warning"]},
      {"category": "Compliance", "examples": ["compliance.case.escalated", "compliance.aml.flagged"]},
      {"category": "CBS sync", "examples": ["cbs.baseline.refreshed", "cbs.transaction.streamed"]},
      {"category": "API audit", "examples": ["api.endpoint.called", "api.audit.emitted"]},
      {"category": "System health", "examples": ["vitals.organ.degraded", "vitals.regression.detected"]}
    ]
  },

  "shadow_dependency_detection_rules": [
    {
      "rule": "Transport-to-transport imports forbidden",
      "example_violation": "from utils.api import pipeline_deals (in pages/3_pipeline.py)",
      "example_ok": "from utils.api_client import call_api"
    },
    {
      "rule": "Engine importing from transport forbidden",
      "example_violation": "from utils.api import _audit (in utils/bsc_engine.py)",
      "fix": "Emit event via event_bus; transport's audit emit happens at route level"
    },
    {
      "rule": "Cross-organ direct import without declared edge = shadow dependency",
      "permitted_exceptions": [
        "Stratum 4 canonical foundations universally importable",
        "Stratum 3 modules within same organ family may cross-import"
      ]
    },
    {
      "rule": "Circular imports CRITICAL",
      "tolerance": "none — even Python's lazy import doesn't excuse",
      "severity": "CRITICAL"
    }
  ],

