# ──────────────────────────────────────────────────────────────────────────
# A2Z MIS 360 — Environment Variables Template
# ──────────────────────────────────────────────────────────────────────────
# Copy to `.env` and fill in values for your environment. Never commit
# the filled-in `.env` to source control.
#
# v10.299 — Documented for the React-readiness Phase 3 arc.
# ──────────────────────────────────────────────────────────────────────────


# ── CORS — Cross-Origin Resource Sharing ─────────────────────────────────
# A comma-separated list of origins allowed to make authenticated requests
# to the API. The React SPA runs on a separate origin in production, so
# this list MUST include the frontend's production URL.
#
# Default (when unset): includes localhost dev servers for
#   - React Create-React-App        (http://localhost:3000)
#   - Vite                          (http://localhost:5173)
#   - Streamlit                     (http://localhost:8501, 8502)
#
# CRITICAL — V-009 SECURITY FIX:
# Never set this to '*' or include '*' in the list. The combination of
# wildcard origin + `allow_credentials=True` (which we require for JWT
# auth) is a known vulnerability that lets any malicious site read
# authenticated responses. The app raises RuntimeError at startup if it
# detects '*' in this list — this is the V-009 guard.
#
# Production example:
#   A2Z_CORS_ORIGINS=https://app.ecobank.co.ke,https://staff.ecobank.co.ke
#
# Empty values fall back to the default localhost list with a warning
# logged at startup (don't ship an empty value to production).
#
A2Z_CORS_ORIGINS=


# ── JWT Authentication ───────────────────────────────────────────────────
# Secret key used to sign JWT access tokens. Must be set in production —
# the default value is intentionally weak so dev/test work, but
# `warn_if_default_secret()` logs a warning at startup if it's still in
# use.
#
# Generate a strong secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
#
# Rotate the secret to invalidate all outstanding sessions.
#
A2Z_JWT_SECRET=


# ── Database / Storage ───────────────────────────────────────────────────
# Toggle individual tables to PG-mode (vs JSON-file mode). Used by the
# G163 migration scoreboard. See utils/db.py for the full list of
# table-toggle env vars.
#
# Master switch — set to "true" to enable PG for all tables that have
# their TABLE_USE_DB flag set (only takes effect once those flags are set
# in code).
#
A2Z_DB_BACKEND=json

# PostgreSQL connection (only needed if A2Z_DB_BACKEND=postgresql)
# A2Z_PG_HOST=localhost
# A2Z_PG_PORT=5432
# A2Z_PG_USER=a2z_user
# A2Z_PG_PASSWORD=
# A2Z_PG_DATABASE=a2z_mis360


# ── FLEXCUBE Integration ─────────────────────────────────────────────────
# Connection details for the Oracle FLEXCUBE core banking system.
# Required for ENH-191 (CIMS), ENH-249 (Finance Close), and other
# arcs that read from core banking. Leave blank in dev to use the
# in-process simulator (returns canned responses for testing).
#
# A2Z_FLEXCUBE_HOST=
# A2Z_FLEXCUBE_PORT=
# A2Z_FLEXCUBE_USER=
# A2Z_FLEXCUBE_PASSWORD=
# A2Z_FLEXCUBE_DATABASE=

# FlexCube EOD bulk export (utils/cbs_etl.py) — CORP + INDI customer/account CSVs
# FLEXCUBE_EOD_BASE_URL=http://10.8.32.3:400
# FLEXCUBE_EOD_TRIGGER_TIMEOUT=900
# FLEXCUBE_EOD_TIMEOUT_SECONDS=300


# ── External services ────────────────────────────────────────────────────
# LLM provider (optional — Cat D engines fall back to rule-based scorers
# when no provider is configured). Used by NLP classification (#167),
# customer behavior intelligence (#337-#348), and other Cat D Rule 7
# scaffolds.
#
# A2Z_LLM_PROVIDER=
# A2Z_LLM_API_KEY=


# ── Observability ────────────────────────────────────────────────────────
# Log level: DEBUG / INFO / WARNING / ERROR
# A2Z_LOG_LEVEL=INFO


# ──────────────────────────────────────────────────────────────────────────
# See DEPLOY.md for the full production deployment guide.
# ──────────────────────────────────────────────────────────────────────────
