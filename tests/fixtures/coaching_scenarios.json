[
  {
    "id": "C001-strong-performer",
    "description": "Top performer on one KPI → script references the win",
    "input": {
      "manager_code": "M1", "staff_code": "S100",
      "is_report": true,
      "staff": {"full_name": "Jane Doe", "role": "Personal Banker", "unit": "Nairobi"},
      "kpi_status": [
        {"kpi_id": "DEP_GROWTH", "current": 130, "target": 100, "achievement_pct": 130, "status": "exceeding"}
      ],
      "nudges": [], "growth_plan": {}, "microtasks": [], "learning_cards": []
    },
    "expected": {
      "non_empty": true,
      "talking_points_must_contain": ["DEP_GROWTH", "exceeding"],
      "agenda_min": 3
    }
  },
