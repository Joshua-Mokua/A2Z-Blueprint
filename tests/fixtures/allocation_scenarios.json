  {
    "id": "A001-simple-3x2-known-optimal",
    "description": "3 customers, 2 RMs, capacity 2 each. Known optimal: C1→RM1(100), C2→RM1(90), C3→RM2(50). Total=240.",
    "input": {
      "segment": "Mass",
      "customers": ["C1", "C2", "C3"],
      "rms": ["RM1", "RM2"],
      "rm_capacity": {"RM1": 2, "RM2": 2},
      "projections": {
        "C1__RM1": {"projected_pbt": 100, "ftp_mode": "on"},
        "C1__RM2": {"projected_pbt": 80, "ftp_mode": "on"},
        "C2__RM1": {"projected_pbt": 90, "ftp_mode": "on"},
        "C2__RM2": {"projected_pbt": 70, "ftp_mode": "on"},
        "C3__RM1": {"projected_pbt": 60, "ftp_mode": "on"},
        "C3__RM2": {"projected_pbt": 50, "ftp_mode": "on"}
      }
    },
    "expected": {
      "total_projected_pbt": 240.0,
      "assignments_made": 3,
      "provisional": false,
      "warning_present": false
    }
  },
