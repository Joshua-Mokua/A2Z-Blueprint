    {
      "id": "DL006",
      "label": "Lending: clean disbursement vs target",
      "engine": "lending",
      "method": "disbursement_by_product",
      "input": {
        "period": "2026-04",
        "disbursements": [
          {"amount": 1000000000, "product": "MORTGAGE"},
          {"amount":  500000000, "product": "PERSONAL"}
