      "id": "DL001",
      "label": "Single segment single product KES",
      "engine": "deposit",
      "method": "aggregate",
      "input": {
        "period": "2026-04",
        "dimensions": ["segment", "product"],
        "snapshots": [
          {"balance": 1000000, "segment": "CORPORATE", "product": "FD", "currency": "KES"}
        ]
      },
      "expected": {
        "buckets": {"CORPORATE|FD": 1000000.00},
        "total": 1000000.00,
        "row_count": 1,
        "unknown_buckets": 0
      }
