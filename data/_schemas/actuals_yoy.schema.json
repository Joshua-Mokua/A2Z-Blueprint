{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Actuals YoY Sidecar",
  "description": "YoY growth sidecar regenerated on every actuals refresh. Keys are '<staff_code>__<kpi_name>'.",
  "_canonical_producer": "utils.live_actuals.save_yoy_sidecar (via refresh_yoy)",
  "type": "object",
  "required": [
    "_doc",
    "_schema_version",
    "computed_at",
    "baseline_date",
    "mapped_count",
    "entries"
  ],
  "properties": {
    "_doc": { "type": "string" },
    "_schema_version": { "type": "string", "enum": ["1.0"] },
    "computed_at": { "type": "string", "format": "date-time" },
    "baseline_date": { "type": "string" },
    "mapped_count": { "type": "integer", "minimum": 0 },
    "entries": {
      "type": "object",
      "description": "Keyed by '<staff_code>__<kpi_name>'.",
      "additionalProperties": {
        "type": "object",
        "required": [
          "staff_code", "kpi_name", "current_value",
          "baseline_value", "growth_pct", "direction", "baseline_path"
        ],
        "properties": {
          "staff_code": { "type": "string" },
          "kpi_name": { "type": "string" },
          "current_value": { "type": "number" },
          "baseline_value": { "type": "number" },
          "growth_pct": { "type": ["number", "null"] },
          "direction": { "type": "string", "enum": ["higher_is_better", "lower_is_better", "neutral"] },
          "baseline_path": { "type": "string" }
        }
      }
    }
  }
}
