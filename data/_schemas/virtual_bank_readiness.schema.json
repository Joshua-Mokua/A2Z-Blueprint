{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Virtual Bank Readiness Report",
  "description": "Output of utils.virtual_bank_readiness.capture_readiness_report. Reconnaissance for the v10.358+ Football Team Test work.",
  "_canonical_producer": "utils.virtual_bank_readiness.save_readiness_report",
  "type": "object",
  "required": [
    "_doc",
    "_schema_version",
    "schema_version",
    "captured_at",
    "modules",
    "boot",
    "coverage",
    "scenarios",
    "chain",
    "overall_status",
    "blockers"
  ],
  "properties": {
    "_doc": { "type": "string" },
    "_schema_version": { "type": "string", "enum": ["1.0"] },
    "schema_version": { "type": "string" },
    "captured_at": { "type": "string" },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["module", "loaded", "line_count", "has_self_test"]
      }
    },
    "boot": { "type": "object" },
    "coverage": { "type": "object" },
    "scenarios": { "type": "object" },
    "chain": { "type": "object" },
    "overall_status": {
      "type": "string",
      "enum": ["READY", "READY_BUT_NOT_VERIFIED", "BLOCKERS", "UNKNOWN"]
    },
    "blockers": { "type": "array", "items": { "type": "string" } },
    "notes": { "type": "array", "items": { "type": "string" } }
  }
}
