PNL_CUSTOMER_KPI = 'Customer Growth'

ALL_PNL_KPIS = PNL_INCOME_KPIS + PNL_BALANCE_KPIS + PNL_QUALITY_KPIS + [PNL_PROFIT_KPI, PNL_CUSTOMER_KPI]

BRANCH_LABELS = {
