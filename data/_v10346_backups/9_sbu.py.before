# ── P&L KPI MAPPING ──────────────────────────────────────────────────
PNL_INCOME_KPIS = ['Disbursements Retail Loans','Total NFI','Collection Throughput',
                    'Treasury','Trade Finance','Bancassurance']
PNL_BALANCE_KPIS = ['Retail & MSME Deposit Growth','Loan Book Growth']
