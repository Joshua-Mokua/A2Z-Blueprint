"""
pages/_manifest_loader.py — read and query the page manifest.

The manifest (pages/_manifest.json) is the canonical registry of every
page file in pages/*.py. Per master prompt v3.62 line 957: "prefer
extending existing patterns over inventing new ones."

This loader is the consume-side of the manifest:
    - app.py reads it to build the navigation
    - 7_admin.py reads it to populate the role assignment tree
    - scripts/audit.py G160 (v10.198) reads it to verify completeness
    - future React migration reads it as the route registry

Shipped: v10.197.
"""
from __future__ import annotations

import json
import threading
from pathlib import Path
from typing import Any, Dict, List, Optional, Tuple


_MANIFEST_PATH = Path(__file__).resolve().parent / "_manifest.json"
_CACHE_LOCK = threading.Lock()
_CACHE: Optional[Dict[str, Any]] = None


def _load() -> Dict[str, Any]:
    """Load and cache the manifest. Thread-safe."""
    global _CACHE
    with _CACHE_LOCK:
        if _CACHE is None:
            if not _MANIFEST_PATH.exists():
                raise FileNotFoundError(
                    f"Manifest not found at {_MANIFEST_PATH}. "
                    f"Page manifest is required from v10.197 onward.")
            try:
                _CACHE = json.loads(_MANIFEST_PATH.read_text(encoding="utf-8"))
            except json.JSONDecodeError as e:
                raise ValueError(f"Manifest at {_MANIFEST_PATH} is invalid JSON: {e}")
    return _CACHE


def reload() -> None:
    """Force reload (e.g. after admin edits the manifest)."""
    global _CACHE
    with _CACHE_LOCK:
        _CACHE = None
    _load()


def list_departments() -> Dict[str, Dict[str, Any]]:
    """Return {dept_id: {label, icon, kind, order}} for all 16 departments."""
    return dict(_load().get("departments", {}))


def list_pages() -> Dict[str, Dict[str, Any]]:
    """Return {filename: page_entry} for all registered pages."""
    return dict(_load().get("pages", {}))


def get_page(filename: str) -> Optional[Dict[str, Any]]:
    """Return manifest entry for a page filename, or None if not registered."""
    return _load().get("pages", {}).get(filename)


def get_page_by_module_path(module_path: str) -> Optional[Tuple[str, Dict[str, Any]]]:
    """Return (filename, entry) for a manifest module_path, or None if not found.

    Reverse lookup from dotted module_path (e.g. 'treasury_alm.alm') to
    its manifest entry. Used by v10.200 dotted-path access resolution to
    find the legacy current_module_key for backward-compat fallback.
    """
    if not module_path or "." not in module_path:
        return None
    for fname, entry in _load().get("pages", {}).items():
        if entry.get("module_path") == module_path:
            return (fname, entry)
    return None


def module_path_to_legacy_key(module_path: str) -> Optional[str]:
    """Resolve a dotted module_path to its current_module_key.

    Used by check_access_dotted to fall back from new dotted granular
    access to legacy MODULE_ACCESS resolution. Returns None if the
    module_path is not registered in the manifest.
    """
    result = get_page_by_module_path(module_path)
    return result[1].get("current_module_key") if result else None


def pages_in_department(dept_id: str, include_secondary: bool = False) -> List[Tuple[str, Dict[str, Any]]]:
    """Return [(filename, entry)] for all pages where dept_id is the primary
    department. If include_secondary, also include pages with dept_id in
    secondary_visibility. Sorted by filename for stable navigation order.
    """
    out: List[Tuple[str, Dict[str, Any]]] = []
    for fname, entry in _load().get("pages", {}).items():
        if entry.get("department_primary") == dept_id:
            out.append((fname, entry))
        elif include_secondary:
            secondary = entry.get("secondary_visibility", [])
            if dept_id in secondary or "__all_departments__" in secondary:
                out.append((fname, entry))
    out.sort(key=lambda x: x[0])
    return out


def page_path_to_module_key(filename: str) -> Optional[str]:
    """Return the legacy module_key (used by check_access) for a filename.
    Backward-compat helper: existing access checks use module_key strings,
    which the manifest preserves under current_module_key for v10.197.
    """
    entry = get_page(filename)
    return entry.get("current_module_key") if entry else None


def is_deprecated(filename: str) -> bool:
    """True if the page is a deprecated cockpit awaiting absorption."""
    entry = get_page(filename)
    return bool(entry and entry.get("deprecated"))


def deprecation_info(filename: str) -> Optional[Dict[str, str]]:
    """Return {target_page, reason} if deprecated, else None."""
    entry = get_page(filename)
    if not entry or not entry.get("deprecated"):
        return None
    return {
        "target_page": entry.get("deprecation_target_page", ""),
        "reason": entry.get("deprecated_reason", ""),
    }


def list_deprecated_cockpits() -> List[Tuple[str, str]]:
    """Return [(filename, target_page)] for all deprecated cockpits.
    Useful for the cockpit absorption tracker (target: v10.250).
    """
    out = []
    for fname, entry in _load().get("pages", {}).items():
        if entry.get("deprecated"):
            out.append((fname, entry.get("deprecation_target_page", "")))
    return sorted(out)


def manifest_version() -> str:
    """Return the manifest's schema version (e.g. 'v10.197')."""
    return _load().get("schema_version", "unknown")


def total_pages() -> int:
    """Return total registered page count."""
    return len(_load().get("pages", {}))


def self_test() -> Dict[str, Any]:
    """Smoke test: verify manifest loads + has expected structure."""
    try:
        m = _load()
        assert "departments" in m, "missing 'departments' key"
        assert "pages" in m, "missing 'pages' key"
        assert "schema_version" in m, "missing 'schema_version' key"
        assert len(m["pages"]) > 0, "no pages registered"
        # Every page must have department_primary + module_path
        for fname, entry in m["pages"].items():
            assert entry.get("department_primary"), f"{fname}: missing department_primary"
            assert entry.get("module_path"), f"{fname}: missing module_path"
            mp = entry["module_path"]
            assert mp.count(".") >= 1, f"{fname}: module_path '{mp}' not dotted"
        # No two pages share module_path
        seen_paths: Dict[str, str] = {}
        for fname, entry in m["pages"].items():
            mp = entry["module_path"]
            if mp in seen_paths:
                raise AssertionError(f"module_path '{mp}' claimed by both {fname} and {seen_paths[mp]}")
            seen_paths[mp] = fname
        return {
            "passed": True,
            "schema_version": m["schema_version"],
            "total_pages": len(m["pages"]),
            "total_departments": len(m["departments"]),
        }
    except Exception as e:
        return {"passed": False, "error": str(e)}


if __name__ == "__main__":
    import json as _json
    result = self_test()
    print(_json.dumps(result, indent=2))
