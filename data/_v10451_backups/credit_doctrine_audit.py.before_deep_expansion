    has_flexcube = bool(re.search(r"flexcube|fcubs|FCUBS", text, re.IGNORECASE))
    criteria.append({
        "number": 6,
        "name": "Flexcube integration compatibility",
        "met": has_flexcube,
        "partial": has_flexcube,
        "evidence": "Flexcube references present" if has_flexcube else "MISSING",
