    criteria.append({
        "number": 8,
        "name": "Department command centre functional",
        "met": crit_8_met,
        "partial": phase_audits["phase_6"].phase_score_pct >= 30.0,
        "evidence": f"Phase 6: {phase_audits['phase_6'].phase_score_pct}%",
    })

