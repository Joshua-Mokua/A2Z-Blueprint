      "weight": 0.25,
      "factor_range": [1.10, 1.20],
      "description": "Top quartile branches — exceed targets"
    },
    "MID": {
      "weight": 0.55,
      "factor_range": [0.92, 1.05],
      "description": "Middle 50% — within performance band"
    },
    "LOW": {
      "weight": 0.20,
      "factor_range": [0.72, 0.88],
      "description": "Bottom quartile — below target"
    }
  },
