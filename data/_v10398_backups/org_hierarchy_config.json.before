  "_v10330_canonical_retail_chain": {
    "shipped": "v10.330",
    "purpose": "Enforce canonical retail chain: BM → Area Manager → Head of Branches → Chief Retail",
    "changes": [
      "TIGHTENED role_manager_whitelist: 'Branch Manager' parent set reduced from [Area Manager, Senior Branch Manager, Head of Branches] to [Area Manager] only",
      "TIGHTENED role_manager_whitelist: 'Senior Branch Manager' parent set reduced from [Area Manager, Head of Branches] to [Area Manager] only",
      "ALIGNED utils/hierarchy_synth.py: Senior Branch Managers now treated as PEERS of standard Branch Managers (both report to Area Manager), not as another supervisory tier"
    ],
    "rationale": "Per banking convention articulated by Joshua: Branch performance = Branch Manager's performance, Area Manager BSC = aggregate of branches reporting to them, Head of Branches BSC = aggregate of Area Managers, Chief Retail BSC = aggregate of Head of Branches. Senior BMs run flagship branches but don't supervise other BMs."
  },
  "profitability_axis": {
    "_doc": "v10.374 — Profitability axis for every role. Complementary to role_tiers (seniority). Five tiers: portfolio_owner (tagged to customers via accounts.csv::relationship_manager_code, drives sales — includes Branch sales like RM PB/BB/DSO/BRM/SRO/RO + HO sales like Sector Specialists/HO Corporate/SME/Sector RMs reporting to Chief Commercial); proposition_owner (owns an overlapping proposition like Women Banking/Diaspora — NOT tagged to accounts, responsible for proposition growth; per Rule 6, propositions overlap by design); structural_owner (owns PBT at structural level via the branch_pbt_allocator or higher rollup — NOT tagged to accounts — includes Branch Manager, Regional Head, Heads of business lines, Directors, MD); service (operational branch role; occasionally tagged when introducing accounts but not primary sales — Teller, CSO, BOS); support (head office support function — Risk/Compliance/IT/HR/Finance/Audit — owns cost center but not direct PBT). Each role also has branch_scope (branch_bound / head_office / national) and optional sbu mapping (Retail Banking / Commercial Banking / Corporate Banking / Treasury / Digital_Agency / Support / Executive).",
    "_schema_version": "v10.374",
    "_last_reviewed": "2026-05-13",
    "_aligns_with": [
      "users.json::role (1449 users, 126 distinct roles)",
      "hr.json::role (200 staff, 26 distinct roles)",
      "target_cascade.json (staff cascade keys)",
      "kpi_library.json DEFAULT_ROLE_KPIS (15 roles)",
      "branch_staff_config.json buckets (CUSTOMER_SERVICE, BRANCH_SALES)",
      "segment_sbu_mapping.json (SBU canonical names)"
    ],
    "tiers": {
      "_note": "The five profitability tiers in order of bank impact directness",
      "portfolio_owner": "Tagged to customers; drives sales; Σ(their customer PBT) attributed",
      "proposition_owner": "Drives overlap proposition (Women Banking, Diaspora, etc.); NOT tagged",
      "structural_owner": "Owns PBT at structural level (branch / region / SBU / bank)",
      "service": "Branch ops; occasionally tagged when introducing accounts",
      "support": "Head office function (risk, compliance, IT, HR, finance, audit)"
    },
    "branch_scopes": {
      "_note": "Where the role physically/organizationally sits",
      "branch_bound": "Works at one specific branch",
      "head_office": "Works at HO; portfolio may span multiple branches",
      "national": "Bank-wide responsibility"
    },
    "role_classification": {
