  "strategic_themes": [
    {
      "theme": "Digital scale gap",
      "leader": "Equity",
      "leader_value": "15.5M digital customers",
      "our_value": "0.52M",
      "gap_pct": 96.6,
      "implication": "Ecobank captures <0.4% of the addressable digital customer base. Catching up to even Co-op (6.3M) would require 12x growth \u2014 likely via acquisition/partnership rather than organic."
    },
    {
      "theme": "Asset quality lead",
      "leader": "Ecobank",
      "leader_value": "11.1% NPL",
      "our_value": "11.1%",
      "gap_pct": 0,
      "implication": "Ecobank has the lowest NPL ratio in the Tier-1 group. This is a credible differentiator with corporate clients seeking conservative lending partners."
    },
    {
      "theme": "Branch network gap",
      "leader": "KCB",
      "leader_value": "223 branches",
      "our_value": "35",
      "gap_pct": 84.3,
      "implication": "Branch presence is 6x smaller than KCB. The strategic question is whether to compete on branches (capital-heavy) or pivot to digital-only \u2014 agency banking has 2,600 agents which is meaningful but still 23x smaller than Equity's 60,000."
    },
    {
      "theme": "Profitability ratio strength",
      "leader": "Equity",
      "leader_value": "23.0% ROE",
      "our_value": "15.3%",
      "gap_pct": 33.5,
      "implication": "ROE gap of 7.7 percentage points vs market leader. Driving this gap closure requires either margin expansion (NIM is already 6.8%, capacity exists) or improved capital deployment (CAR at 19.0% suggests excess capital."
    },
    {
      "theme": "Cost efficiency improvement runway",
      "leader": "Equity",
      "leader_value": "45% CIR",
      "our_value": "54%",
      "gap_pct": 16.7,
      "implication": "CIR of 54% is 9pp behind Equity. Each 1pp improvement on KES 11.5B revenue \u2248 KES 115M annual savings. Targeting 49% by 2027 (KCB's level) would deliver KES 575M annual value."
    }
