{
  "_schema_version": "v10.334",
  "_description": "Specialized Segments + Propositions activity generator config. Each proposition has a head and (sometimes) dedicated staff. The head's BSC = the proposition's BSC (per banking convention \u2014 segment performance = segment owner's performance). Covers the 3 specialized segments not yet in cascade: WB (Women Banking), DIA (Diaspora), AGR (Agribusiness). Other 5 propositions (SME, GOV, TF, BNC, DFS) already score via Pipeline\u2192BSC bridge or Support Function generator.",
  "_design_principles": [
    "Head BSC reflects segment-level performance, not personal sales",
    "Staff under proposition heads get RM-style scorecards (deposit, NFI, NPL, etc.)",
    "Deterministic per (staff_code, period, kpi_id)",
    "Direction-aware (NPL/PAR lower-is-better)",
    "Scale-aware (currency-M bases convert to raw currency)",
    "Customer-count weighted \u2014 bigger segments have larger base KPIs"
  ],
  "performance_bands": {
    "HIGH": {
      "weight": 0.25,
      "factor_range": [
        1.05,
        1.15
      ],
      "description": "Top performers \u2014 beat targets"
    },
    "MID": {
      "weight": 0.55,
      "factor_range": [
        0.92,
        1.05
      ],
      "description": "On-track \u2014 within band"
    },
    "LOW": {
      "weight": 0.2,
      "factor_range": [
        0.78,
        0.9
      ],
      "description": "Below target"
    }
  },
