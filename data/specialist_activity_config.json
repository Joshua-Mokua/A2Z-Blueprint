{
  "_schema_version": "v10.336",
  "_description": "Specialist department activity generator config. Brings Treasury, Trade Finance specialists, and Marketing departments into the BSC cascade — three subtrees that previously had K-coded role_kpis with no producer feeding them. Mirrors v10.317 Teller / v10.327 Credit / v10.328 Support / v10.334 Propositions pattern. Closes the majority of B-027 (department coverage gap).",
  "_design_principles": [
    "Specialist KPIs reflect departmental discipline (Treasury = liquidity + FX + NIM; TF = trade revenue + doc TAT + LC volume; Marketing = campaign ROI + brand + lead gen)",
    "Deterministic per (staff_code, period, kpi_id)",
    "Direction-aware (TAT lower-is-better; revenue/ROI higher-is-better)",
    "Scale-aware (currency-M bases convert to raw currency at output)",
    "Heads receive aggregate KPIs that mirror their department's collective performance"
  ],
  "performance_bands": {
    "HIGH": {
      "weight": 0.25,
      "factor_range": [1.05, 1.15],
      "description": "Top performers — beat targets"
    },
    "MID": {
      "weight": 0.55,
      "factor_range": [0.92, 1.05],
      "description": "On-track — within band"
    },
    "LOW": {
      "weight": 0.20,
      "factor_range": [0.78, 0.90],
      "description": "Below target"
    }
  },
  "departments": {
    "TREASURY": {
      "name": "Treasury",
      "scope_filter": "department == 'Treasury'",
      "staff_count_target": 7,
      "head_role": "Head of Treasury",
      "head_band_weights": {"HIGH": 0.30, "MID": 0.55, "LOW": 0.15},
      "_note": "Treasury covers ALM, FX dealing, money markets, and intraday liquidity. Head of Treasury already scores via support_function_generator (300164); specialist generator adds the dealing-room and operations staff."
    },
    "TRADE_FINANCE": {
      "name": "Trade Finance Specialists",
      "scope_filter": "department == 'Trade Finance'",
      "staff_count_target": 10,
      "head_role": "Trade Finance Back Office Manager",
      "head_band_weights": {"HIGH": 0.30, "MID": 0.55, "LOW": 0.15},
      "_note": "TF specialists sit under Head Corp & TF (300017) who already scores via products_to_bsc + pipeline_bridge. This generator brings the operations + back-office + 3 RMs into the cascade with TF-specific KPIs."
    },
    "MARKETING": {
      "name": "Marketing",
      "scope_filter": "department == 'Marketing'",
      "staff_count_target": 4,
      "head_role": "Head Of Marketing and Corporate Communication",
      "head_band_weights": {"HIGH": 0.25, "MID": 0.55, "LOW": 0.20},
      "_note": "Marketing reports to CCO. KPIs reflect campaign-driven revenue, brand health, and qualified lead generation — connecting to pipeline_to_bsc downstream where leads become deals."
    }
  },
